# Discord bot
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Postgres (Supabase connection string)
DATABASE_URL=postgres://user:password@host:5432/postgres

# lostark.bible OAuth API
LA_BIBLE_BASE_URL=https://lostark.bible

# 32-byte key (64 hex chars) used to encrypt access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# How often the scheduler polls tracked characters, in minutes
POLL_INTERVAL_MINUTES=10

# lostark.bible OAuth API Client Id (public client, no secret — see
# src/lostarkbible/oauth.js, uses PKCE instead)
LA_BIBLE_CLIENT_ID=

# Port the /oauth/callback server listens on, and the exact redirect URI
# registered for LA_BIBLE_CLIENT_ID on lostark.bible's side. Defaults below
# are for local dev; production sets OAUTH_REDIRECT_URI to
# https://lostarkbot.fly.dev/oauth/callback.
OAUTH_PORT=3000
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
