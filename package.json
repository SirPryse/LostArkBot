{
  "name": "lostarkbot",
  "version": "0.1.0",
  "description": "Discord bot that announces newly completed raids for lostark.bible-linked characters",
  "type": "module",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:down": "node scripts/migrate.js down",
    "deploy-commands": "node src/discord/deployCommands.js"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "node-pg-migrate": "^7.9.1",
    "pg": "^8.13.1"
  }
}
